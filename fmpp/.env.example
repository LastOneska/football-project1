# Football Match Probability Predictor - Environment Variables Template
# Copy file ini menjadi .env dan isi dengan API key Anda

# football-data.org API Key (gratis di https://www.football-data.org/)
FOOTBALL_DATA_ORG_API_KEY=your_api_key_here

# api-sports.io (API-Football) API Key (gratis di https://www.api-football.com/)
API_FOOTBALL_KEY=your_api_key_here

# Konfigurasi umum
DEFAULT_LAST_N=5
TIMEZONE=Asia/Jakarta
DATABASE_PATH=data/fmpp.db

# Hosted PostgreSQL (e.g. Neon) for Vercel. Leave empty for local SQLite.
DATABASE_URL=

# Vercel Cron protection; set a long random value in Vercel Environment Variables.
CRON_SECRET=
